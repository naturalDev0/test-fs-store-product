PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/store
# Used only by `npm test`; the test suite wipes this database.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/store_test
# Use a long random string in any real deployment.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h
CORS_ORIGIN=http://localhost:5173
# Credentials for the admin account created by `npm run db:seed`.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
